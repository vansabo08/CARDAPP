# ---------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------
# Estas duas sao publicas por natureza: viajam no JavaScript que o
# browser descarrega. Quem protege os dados e a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dominio publico usado nos QR codes das mesas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Segredos — nunca com prefixo NEXT_PUBLIC_
# So sao lidos no servidor. Se levassem o prefixo, o Next punha-os
# no pacote que qualquer cliente descarrega.
# ---------------------------------------------------------------

# Supabase, chave de servico. Passa por cima da RLS: e precisa para o
# email da manha ler os pedidos de todos os donos.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Remetente. Sem dominio verificado o Resend so aceita este endereco,
# e so envia para o email da propria conta.
RESEND_REMETENTE=Cardapp <onboarding@resend.dev>

# Quem entra no painel administrativo (/admin), separados por virgula.
# Vive no ambiente e nao na base de dados de proposito: se a lista
# estivesse numa tabela, o ecra que a editasse seria a forma mais facil
# de alguem se promover a si proprio.
ADMIN_EMAILS=

# Protege /api/tarefas/resumo-diario. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------
# Operacao — so para correr scripts/vercel-variaveis.mjs
# ---------------------------------------------------------------
# Da controlo total da conta Vercel dentro do seu scope. Cria em
# vercel.com/account/tokens com validade curta e apaga quando acabares.
# A aplicacao nunca o le em tempo de execucao.
VERCEL_TOKEN=
